{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", ".firebaserc", "generate-icons.html"],
    "rewrites": [
      { "source": "**", "destination": "/field-records.html" }
    ],
    "headers": [
      {
        "source": "/sw.js",
        "headers": [{"key": "Cache-Control", "value": "no-cache"}]
      },
      {
        "source": "**",
        "headers": [{"key": "Cache-Control", "value": "max-age=31536000"}]
      }
    ]
  }
}
